VOLERO_CLIENT_ID=
VOLERO_CLIENT_SECRET=
PORT=4173
# Live booking charges the supplier account. Off unless set to true (the site has no booking flow yet).
VOLERO_BOOKING_ENABLED=false
# Gerbi AI decision partner (optional; without a key everything runs deterministic). Server side only.
ANTHROPIC_API_KEY=
# GERBI_LLM_MODEL=claude-opus-5-5   (e.g. claude-haiku-5-5 for a cheaper partner)
# GERBI_LLM_DAILY_TOKENS=200000
# Persistent query memory + LLM cache on Vercel (Upstash Redis REST). Locally: data/*.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
