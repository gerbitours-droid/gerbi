VOLERO_CLIENT_ID=
VOLERO_CLIENT_SECRET=
PORT=4173
# Live booking charges the supplier account. Off unless set to true (the site has no booking flow yet).
VOLERO_BOOKING_ENABLED=false
# Gerbi AI (spec 22; optional — without keys every feature runs on rules). Server side only.
# Chain order: GERBI_AI_PROVIDERS (default anthropic,openrouter,deepseek); GERBI_LLM_PROVIDER puts one first.
ANTHROPIC_API_KEY=
# Model per tier: fast=claude-haiku-5-5 (support, forms, flights) · smart=claude-sonnet-5-5 (planner, leads, digest) · write=claude-opus-5-5 (blog)
# GERBI_ANTHROPIC_MODEL_FAST= / GERBI_ANTHROPIC_MODEL_SMART= / GERBI_ANTHROPIC_MODEL_WRITE=
OPENROUTER_API_KEY=
# GERBI_LLM_MODEL=qwen/qwen3.8-max-0902
DEEPSEEK_API_KEY=
# GERBI_DEEPSEEK_MODEL=deepseek-chat
# Caps and switches: daily USD cap (default 3), daily tokens (default 400000), tasks to switch off ("all" or e.g. support_answer,blog_draft)
# GERBI_AI_DAILY_USD=3
# GERBI_LLM_DAILY_TOKENS=400000
# GERBI_AI_DISABLED=
# Development only (refused on Vercel/production): node scripts/mock-llm-server.mjs 4199
# GERBI_AI_MOCK_URL=http://127.0.0.1:4199/v1/chat/completions
# Persistent query memory + LLM cache on Vercel (Upstash Redis REST). Locally: data/*.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
