VOLERO_CLIENT_ID=
VOLERO_CLIENT_SECRET=
PORT=4173
# Live booking charges the supplier account. Off unless set to true (the site has no booking flow yet).
VOLERO_BOOKING_ENABLED=false
# Gerbi AI decision partner (optional; without keys everything runs deterministic). Server side only.
# First provider with a key answers; the next one covers its failures. GERBI_LLM_PROVIDER=openrouter|deepseek|anthropic puts one first.
OPENROUTER_API_KEY=
# GERBI_LLM_MODEL=qwen/qwen3.8-max-0902   (or qwen/qwen3.8-flash for a cheaper partner)
DEEPSEEK_API_KEY=
# GERBI_DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
# GERBI_LLM_DAILY_TOKENS=200000
# Persistent query memory + LLM cache on Vercel (Upstash Redis REST). Locally: data/*.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
