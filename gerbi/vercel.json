{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/leads-admin", "destination": "/leads-admin.html" }
  ],
  "headers": [
    { "source": "/leads-admin(.html)?", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
